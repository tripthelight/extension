# App
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=false

# CORS
# Comma separated list. Example:
# CORS_ORIGIN=https://www.youtube.com,chrome-extension://your-extension-id
CORS_ORIGIN=https://www.youtube.com,chrome-extension://your-extension-id

# Extension auth
EXTENSION_SHARED_TOKEN=generate_a_unique_64_plus_character_random_token

# YouTube Data API v3
YOUTUBE_API_KEY=replace_me
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_TIMEOUT_MS=7000
YOUTUBE_BATCH_SIZE=50

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=ytrs
REDIS_VIDEO_TTL_SECONDS=604800
REDIS_PENDING_TTL_SECONDS=30

# Cloudflare Workers cache options
# Option 1: bind a Cloudflare KV namespace as CACHE_KV in wrangler.toml.
# Option 2: set these Upstash Redis REST variables in Cloudflare Workers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limit
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX=30
RESOLVE_RATE_LIMIT_WINDOW_MS=10000
RESOLVE_RATE_LIMIT_MAX=20

# Request limits
MAX_VIDEO_IDS_PER_REQUEST=50

# Cost safety
WORKER_ENABLED=true
REQUIRE_ALLOWED_ORIGIN=true
DAILY_YOUTUBE_FETCH_LIMIT=1000
CHALLENGE_REQUIRED=true
CHALLENGE_TTL_SECONDS=60
CHALLENGE_SECRET=generate_a_unique_64_plus_character_random_secret
