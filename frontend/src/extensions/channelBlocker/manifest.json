{
  "manifest_version" : 3,
  "name": "Youtube Channel Ban",
  "version": "1.0.0",
  "description": "You can block channels even when logged out of YouTube.",
  "permissions": ["tabs", "storage", "contextMenus"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8080/*",
    "https://twilight-cherry-8d84.dbkim2013.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": [
        "contents.js"
      ],
      "css": ["contents.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.js"],
      "matches": ["https://*.youtube.com/*"]
    }
  ]
}
